# CI packaging stage — the binary is cross-compiled by `make build-linux*` in the
# Build job and injected into the build context; no Go toolchain needed here.
# For building from source locally, use the main Dockerfile (`make docker`).
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata

COPY xboard-node-linux /usr/local/bin/xboard-node

RUN mkdir -p /etc/xboard-node

WORKDIR /etc/xboard-node

ENTRYPOINT ["xboard-node"]
CMD ["-c", "/etc/xboard-node/config.yml"]
